{"nodes": [{"id": "public_reference_architecture_site_reference_climate_standard", "label": "Site Reference Climate Standard (PUBLIC) \u2014 6 cities", "file_type": "document", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_free_cooling_windows", "label": "Site Free-Cooling Window (climate-driven design parameter)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-site FC window drives cooling architecture: Kemi 4-5 mo, UAE 4-5 mo, Astana 4-5 mo, Chiang Mai 4-5 mo (May-Oct forced mech), Dallas 5-6 mo, Austin 5-6 mo. Determines hybrid chiller vs dry cooler selection."}, {"id": "concept_antifreeze_glycol_design", "label": "Glycol antifreeze concentration by extreme low temp", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kemi (-43C) >=40% glycol + -40C circuit; Astana (-52C) 50-55% glycol + -55C circuit; Dallas (-23C) glycol backup; Austin (-30C) glycol. PG25 (25% propylene glycol) locked for DC45 TCS."}, {"id": "concept_corrosion_class_by_site", "label": "ISO 12944 Corrosion Class by Site (C2-C5-M)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kemi coastal C4-M (C5-M recommended); UAE coastal/dusty C5-M (>=500m from coast); Astana inland C3; Chiang Mai inland C3; Dallas inland C2-C3; Austin inland C2-C3. Driven by salt-spray + humidity exposure."}, {"id": "site_kemi_finland", "label": "Kemi, Finland reference site (subarctic coastal, free cooling priority)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kemi: -43C to +33C, Bothnian Bay coastal salt spray, FC 4-5 mo, PUE ~1.02-1.08 for AC40/AC45. C4-M (C5-M recommended)."}, {"id": "site_uae_dubai", "label": "UAE (Dubai/Abu Dhabi) reference site (BWh desert)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UAE: +5C to +53C, Persian Gulf salt spray + dust storms, FC 4-5 mo, wet bulb 22-27C enables wet-film effectiveness (15-25% chiller power reduction). PUE ~1.25-1.35 high-temp DX, ~1.15 FC. C5-M corrosion."}, {"id": "site_astana_kazakhstan", "label": "Astana, Kazakhstan reference site (extreme continental)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Astana: -52C to +42C, 90K annual swing. 50-55% glycol, -55C circuit coverage. FC 4-5 mo. PUE ~1.07-1.15 for DC45. BESS 30-min full load, generator <=30s start. C3 corrosion."}, {"id": "site_chiangmai_thailand", "label": "Chiang Mai, Thailand reference site (tropical savanna)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chiang Mai: +4C to +43C, rainy season RH 80-84% wet bulb 25-26C makes FC nearly ineffective May-Oct. Mandatory Hybrid Chiller, wet-film not recommended. PM2.5 burning season Mar-Apr. Medium seismic zone. C3 corrosion."}, {"id": "site_dallas_texas", "label": "Dallas, Texas reference site (Cfa humid subtropical, tornado alley)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dallas: -23C to +45C, FC 5-6 mo, wet bulb 21-24C better than Chiang Mai. 130 mph (58 m/s) wind load for tornado alley. ERCOT 2021 outage history -> BESS mandatory. C2-C3 corrosion."}, {"id": "site_austin_texas", "label": "Austin, Texas reference site (Cfa semi-arid, Winter Storm Uri)", "file_type": "concept", "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Austin: -19C to +44C, FC 5-6 mo, dry heat waves 42-44C sustained. Winter Storm Uri 2021 -> -30C freeze design, BESS for multi-day outages. Water-management critical (2022 reservoir crisis). C2-C3 corrosion."}], "edges": [{"source": "public_reference_architecture_site_reference_climate_standard", "target": "reference_architecture_site_reference_climate_standard", "relation": "semantically_similar_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "weight": 1.0}, {"source": "public_reference_architecture_site_reference_climate_standard", "target": "site_kemi_finland", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location": null, "weight": 1.0}, {"source": "public_reference_architecture_site_reference_climate_standard", "target": "site_uae_dubai", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PUBLIC/Reference_Architecture/Site_Reference_Climate_Standard.md", "source_location":